# Caddy gets and renews the Let's Encrypt certificate for $DOMAIN on its own.
{$DOMAIN} {
	encode zstd gzip
	reverse_proxy api:8080

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# The health endpoint is for the deploy check; the rest of actuator stays internal.
	@actuator {
		path /actuator/*
		not path /actuator/health
	}
	respond @actuator 404
}
